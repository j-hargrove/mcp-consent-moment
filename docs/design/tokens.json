{
  "$description": "MCP Consent Moment — token contract (DTCG 2025.10). Primitives are canonical source values; everything else aliases them.",
  "color": {
    "$type": "color",
    "palette": {
      "oxblood": { "$value": "#370405" },
      "film-red": { "$value": "#74080A" },
      "rust": { "$value": "#7B230D" },
      "brown": { "$value": "#824828" },
      "terracotta": { "$value": "#AF5B41" },
      "salmon": { "$value": "#B97155" },
      "teal": { "$value": "#016860" },
      "slate": { "$value": "#3D546B" },
      "forest": { "$value": "#0D4235" },
      "navy": { "$value": "#08132C" }
    },
    "neutral": {
      "field": { "$value": "#E3E8EF", "$description": "Page; secondary text on red/oxblood" },
      "surface": { "$value": "#F4F6F9", "$description": "Cards" },
      "border": { "$value": "#C9D1DC", "$description": "Hairlines; read-tier frame" },
      "white": { "$value": "#FFFFFF", "$description": "Draft preview fill; text on film red and navy" }
    },
    "role": {
      "ink": { "$value": "{color.palette.navy}" },
      "text-secondary": { "$value": "{color.palette.slate}" },
      "notice-passive": { "$value": "{color.palette.slate}", "$description": "Connection lost, retrying" },
      "agent": { "$value": "{color.palette.teal}", "$description": "Agent light, status line, running state. Strokes/text only" },
      "agent-stopped": { "$value": "{color.palette.slate}" },
      "approved": { "$value": "{color.palette.forest}", "$description": "Light backgrounds only. Filled shapes" },
      "time": { "$value": "{color.palette.brown}", "$description": "Timestamps, timelines" },
      "brand": { "$value": "{color.palette.rust}", "$description": "Brand frame only. Never next to an alert" },
      "alert": { "$value": "{color.palette.film-red}", "$description": "Needs a human now" },
      "stop": { "$value": "{color.palette.film-red}" },
      "button-primary-bg": { "$value": "{color.palette.navy}" },
      "button-primary-text": { "$value": "{color.neutral.white}" }
    },
    "tier": {
      "read": {
        "chip-border": { "$value": "{color.palette.navy}" },
        "chip-text": { "$value": "{color.palette.navy}" },
        "frame": { "$value": "{color.neutral.border}" }
      },
      "write": {
        "chip-bg": { "$value": "{color.palette.slate}" },
        "chip-text": { "$value": "{color.neutral.surface}" },
        "frame": { "$value": "{color.palette.slate}" },
        "draft-border": { "$value": "{color.palette.slate}" }
      },
      "scope-creep": {
        "chip-border": { "$value": "{color.palette.terracotta}" },
        "chip-text": { "$value": "{color.palette.oxblood}" },
        "frame": { "$value": "{color.palette.terracotta}" }
      },
      "destructive": {
        "chip-bg": { "$value": "{color.palette.film-red}" },
        "chip-text": { "$value": "{color.neutral.surface}" },
        "panel": { "$value": "{color.palette.film-red}" },
        "panel-text": { "$value": "{color.neutral.white}" },
        "panel-text-secondary": { "$value": "{color.neutral.field}" },
        "panel-chip-bg": { "$value": "{color.palette.oxblood}" },
        "panel-chip-text": { "$value": "{color.neutral.field}" },
        "panel-button-bg": { "$value": "{color.neutral.white}" },
        "panel-button-text": { "$value": "{color.palette.oxblood}" }
      },
      "alert": {
        "frame": { "$value": "{color.palette.film-red}" },
        "chip-bg": { "$value": "{color.palette.film-red}" },
        "chip-text": { "$value": "{color.neutral.surface}" }
      },
      "receipt": {
        "panel": { "$value": "{color.palette.navy}" },
        "panel-icon": { "$value": "{color.neutral.field}" },
        "panel-text": { "$value": "{color.neutral.white}" },
        "panel-text-secondary": { "$value": "{color.neutral.field}" }
      }
    },
    "trace": {
      "granted": { "$value": "{color.palette.forest}" },
      "grant-ends": { "$value": "{color.palette.terracotta}", "$description": "Dashed line" },
      "new-outline": { "$value": "{color.palette.terracotta}" },
      "new-fill": { "$value": "{color.palette.salmon}", "$description": "Half-fill, higher consequence. Never under text" },
      "new-open": { "$value": "{color.palette.navy}", "$description": "Open node, low consequence" },
      "high-line": { "$value": "{color.palette.film-red}" },
      "high-node": { "$value": "{color.palette.oxblood}" },
      "hop-text": { "$value": "{color.palette.oxblood}", "$description": "Hop connector label" },
      "declined": { "$value": "{color.palette.navy}", "$description": "Outline node with strike" }
    },
    "thesis": {
      "1": {
        "rule": { "$value": "{color.palette.navy}" },
        "text": { "$value": "{color.palette.navy}" }
      },
      "2": {
        "rule": { "$value": "{color.palette.slate}" },
        "text": { "$value": "{color.palette.slate}" }
      },
      "3": {
        "rule": { "$value": "{color.palette.brown}" },
        "text": { "$value": "{color.palette.brown}" }
      },
      "4": {
        "rule": { "$value": "{color.palette.terracotta}" },
        "text": { "$value": "{color.palette.rust}", "$description": "Contrast deviation: terracotta text fails AA at 10px" }
      },
      "5": {
        "rule": { "$value": "{color.palette.film-red}" },
        "text": { "$value": "{color.palette.film-red}" }
      },
      "inactive-text": { "$value": "{color.palette.slate}" }
    }
  },
  "border-width": {
    "$type": "dimension",
    "hairline": { "$value": {"value": 1, "unit": "px"} },
    "write": { "$value": {"value": 1.5, "unit": "px"} },
    "scope-creep": { "$value": {"value": 2, "unit": "px"} },
    "alert": { "$value": {"value": 2, "unit": "px"} },
    "thesis-rule": { "$value": {"value": 2, "unit": "px"} },
    "trace": { "$value": {"value": 2, "unit": "px"} },
    "trace-heavy": { "$value": {"value": 4, "unit": "px"}, "$description": "Destructive / high trace line" },
    "focus": { "$value": {"value": 2, "unit": "px"} }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["IBM Plex Sans", "sans-serif"], "$description": "Human decides. All UI" },
      "mono": { "$value": ["IBM Plex Mono", "monospace"], "$description": "Machine speaks. Traces, diffs, timestamps, thesis strip" },
      "brand": { "$value": ["Tektur", "sans-serif"], "$description": "Brand frame / hero only" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "decision": { "$value": 600 },
      "brand": { "$value": 700 }
    },
    "line-height": {
      "$type": "number",
      "$description": "Locked Nov 6, 2026",
      "tight": { "$value": 1.1 },
      "snug": { "$value": 1.4 },
      "relaxed": { "$value": 1.45 },
      "body": { "$value": 1.5 }
    },
    "size": {
      "$type": "dimension",
      "$description": "Type scale. Old sizes snapped to the nearest step, ties up",
      "xs": { "$value": {"value": 10, "unit": "px"} },
      "s": { "$value": {"value": 12, "unit": "px"} },
      "m": { "$value": {"value": 14, "unit": "px"} },
      "l": { "$value": {"value": 18, "unit": "px"} },
      "decision": { "$value": {"value": 22, "unit": "px"}, "$description": "The sentence being decided; largest text in a card body" },
      "hero": { "$value": {"value": 36, "unit": "px"}, "$description": "Destructive hero value" },
      "thesis": { "$value": "{font.size.xs}", "$description": "Thesis strip" }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "Space scale and concepts (Nathan Curtis, Space in Design Systems). Components use concepts, never the scale directly: padding = inset, vertical gap = stack, horizontal gap = inline",
    "xxs": { "$value": {"value": 2, "unit": "px"} },
    "xs": { "$value": {"value": 4, "unit": "px"} },
    "s": { "$value": {"value": 8, "unit": "px"} },
    "sm": { "$value": {"value": 12, "unit": "px"} },
    "m": { "$value": {"value": 16, "unit": "px"} },
    "l": { "$value": {"value": 24, "unit": "px"} },
    "xl": { "$value": {"value": 32, "unit": "px"} },
    "inset": {
      "$description": "Equal padding on all sides",
      "xxs": { "$value": "{space.xxs}" },
      "xs": { "$value": "{space.xs}" },
      "sm": { "$value": "{space.sm}" },
      "m": { "$value": "{space.m}" },
      "xl": { "$value": "{space.xl}" }
    },
    "inset-squish": {
      "$description": "Padding with the vertical one scale step below the horizontal",
      "xxs": {
        "vertical": { "$value": "{space.xxs}" },
        "horizontal": { "$value": "{space.xs}" }
      },
      "xs": {
        "vertical": { "$value": "{space.xs}" },
        "horizontal": { "$value": "{space.s}" }
      },
      "s": {
        "vertical": { "$value": "{space.s}" },
        "horizontal": { "$value": "{space.sm}" }
      },
      "m": {
        "vertical": { "$value": "{space.sm}" },
        "horizontal": { "$value": "{space.m}" }
      }
    },
    "stack": {
      "$description": "Vertical gap between stacked items; one-sided vertical padding",
      "xxs": { "$value": "{space.xxs}" },
      "xs": { "$value": "{space.xs}" },
      "s": { "$value": "{space.s}" },
      "sm": { "$value": "{space.sm}" },
      "m": { "$value": "{space.m}" },
      "l": { "$value": "{space.l}" },
      "xl": { "$value": "{space.xl}" }
    },
    "inline": {
      "$description": "Horizontal gap between items in a row; one-sided horizontal padding",
      "xxs": { "$value": "{space.xxs}" },
      "xs": { "$value": "{space.xs}" },
      "s": { "$value": "{space.s}" },
      "sm": { "$value": "{space.sm}" },
      "m": { "$value": "{space.m}" },
      "l": { "$value": "{space.l}" }
    }
  },
  "size": {
    "$type": "dimension",
    "$description": "Fixed sizes. Everything else hugs or fills",
    "icon": { "$value": {"value": 16, "unit": "px"}, "$description": "Carbon icon glyph" },
    "checkbox": { "$value": {"value": 18, "unit": "px"}, "$description": "Checkbox box. The consequence indent is checkbox + space.inline.s" },
    "chip-column": { "$value": {"value": 42, "unit": "px"}, "$description": "Activity sidebar tier-chip column: the widest compact chip (WRITE, 42 in the browser), so tool names share a left edge" },
    "node": { "$value": {"value": 12, "unit": "px"}, "$description": "Trace node and agent light" },
    "label-column": { "$value": {"value": 100, "unit": "px"}, "$description": "Field and timeline label column, so values line up" },
    "sidebar-width": { "$value": {"value": 300, "unit": "px"} },
    "card-width": { "$value": {"value": 640, "unit": "px"}, "$description": "Consent card width" },
    "column-max": { "$value": {"value": 1200, "unit": "px"}, "$description": "Main column cap" }
  },
  "tracking": {
    "$type": "dimension",
    "$description": "Letter-spacing, locked Nov 6, 2026. Documented DTCG exception: em is outside the dimension units (px, rem), approved so tracking scales with type",
    "tight": { "$value": {"value": -0.02, "unit": "em"} },
    "snug": { "$value": {"value": 0.01, "unit": "em"} },
    "normal": { "$value": {"value": 0.04, "unit": "em"} },
    "wide": { "$value": {"value": 0.08, "unit": "em"} },
    "wider": { "$value": {"value": 0.1, "unit": "em"} }
  },
  "opacity": {
    "$type": "number",
    "dim": { "$value": 0.4 },
    "ring": { "$value": 0.25, "$description": "Agent light ring while waiting" },
    "pulse": { "$value": 0.55, "$description": "Low point of the sidebar waiting pulse" }
  },
  "radius": {
    "$type": "dimension",
    "$description": "Corner radius. Old radii snapped to the nearest step",
    "s": { "$value": {"value": 4, "unit": "px"} },
    "m": { "$value": {"value": 8, "unit": "px"} },
    "circle": { "$value": {"value": 9999, "unit": "px"} }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": {"value": 120, "unit": "ms"}, "$description": "Hover, checkbox, chip, icon press" },
      "base": { "$value": {"value": 200, "unit": "ms"}, "$description": "Card enter, thesis strip change" },
      "slow": { "$value": {"value": 400, "unit": "ms"}, "$description": "Trace draw, dashed to solid" },
      "scan": { "$value": {"value": 450, "unit": "ms"}, "$description": "Card scan line" },
      "deliberate": { "$value": {"value": 600, "unit": "ms"}, "$description": "Destructive beat before confirm is live" },
      "speak": { "$value": {"value": 900, "unit": "ms"}, "$description": "Agent light, speaking" },
      "breathe": { "$value": {"value": 3200, "unit": "ms"}, "$description": "Agent light, working" },
      "char-delay": { "$value": {"value": 22, "unit": "ms"}, "$description": "Status line types on" },
      "trace-stagger": { "$value": {"value": 100, "unit": "ms"} },
      "receipt-stagger": { "$value": {"value": 40, "unit": "ms"} },
      "double-commit-guard": { "$value": {"value": 1000, "unit": "ms"}, "$description": "Destructive buttons ignore repeat clicks" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.2,0,0,1] }
    }
  },
  "pace": {
    "$type": "duration",
    "$description": "Simulated agent tempo: how long the scripted agent waits between steps. Machine time, not UI motion. Never shortened by reduced motion",
    "step": { "$value": {"value": 400, "unit": "ms"}, "$description": "Short beat before the next step or the receipt" },
    "read": { "$value": {"value": 500, "unit": "ms"}, "$description": "After each silent read" },
    "beat": { "$value": {"value": 600, "unit": "ms"}, "$description": "Between beats" },
    "fallback": { "$value": {"value": 700, "unit": "ms"}, "$description": "The agent says what it will fall back to before it runs" },
    "hold": { "$value": {"value": 900, "unit": "ms"}, "$description": "Hold so a result lands before the next gate: draft becomes real, manual retry" },
    "retry": { "$value": {"value": 1300, "unit": "ms"}, "$description": "Automatic retry backoff" }
  }
}
